{
  "$schema": "vscode://schemas/color-theme",
  "name": "Mono BW",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#0A0A0A",
    "editor.foreground": "#E6E6E6",
    "editorCursor.foreground": "#FFFFFF",
    "editor.selectionBackground": "#FFFFFF26",
    "editor.inactiveSelectionBackground": "#FFFFFF12",
    "editor.selectionHighlightBackground": "#FFFFFF14",
    "editor.wordHighlightBackground": "#FFFFFF12",
    "editor.wordHighlightStrongBackground": "#FFFFFF1C",
    "editor.findMatchBackground": "#FFFFFF33",
    "editor.findMatchHighlightBackground": "#FFFFFF1A",
    "editor.lineHighlightBackground": "#FFFFFF08",
    "editor.rangeHighlightBackground": "#FFFFFF0A",
    "editorLineNumber.foreground": "#454545",
    "editorLineNumber.activeForeground": "#A6A6A6",
    "editorWhitespace.foreground": "#2A2A2A",
    "editorIndentGuide.background1": "#1C1C1C",
    "editorIndentGuide.activeBackground1": "#3A3A3A",
    "editorRuler.foreground": "#1C1C1C",
    "editorBracketMatch.background": "#FFFFFF14",
    "editorBracketMatch.border": "#FFFFFF66",
    "editorBracketHighlight.foreground1": "#D9D9D9",
    "editorBracketHighlight.foreground2": "#9C9C9C",
    "editorBracketHighlight.foreground3": "#6E6E6E",
    "editorBracketHighlight.foreground4": "#D9D9D9",
    "editorBracketHighlight.foreground5": "#9C9C9C",
    "editorBracketHighlight.foreground6": "#6E6E6E",
    "editorGutter.background": "#0A0A0A",
    "editorGutter.modifiedBackground": "#CFA35C",
    "editorGutter.addedBackground": "#A8C280",
    "editorGutter.deletedBackground": "#CC5747",
    "editorOverviewRuler.border": "#00000000",
    "editorWidget.background": "#181818",
    "editorWidget.border": "#262626",
    "editorSuggestWidget.background": "#181818",
    "editorSuggestWidget.border": "#262626",
    "editorSuggestWidget.selectedBackground": "#FFFFFF1A",
    "editorSuggestWidget.highlightForeground": "#FFFFFF",
    "editorHoverWidget.background": "#181818",
    "editorHoverWidget.border": "#262626",
    "editorError.foreground": "#CC5747",
    "editorWarning.foreground": "#CFA35C",
    "editorInfo.foreground": "#8AA9C4",
    "errorForeground": "#CC5747",
    "editorCodeLens.foreground": "#5C5C5C",
    "editorLink.activeForeground": "#FFFFFF",

    "foreground": "#C2C2C2",
    "descriptionForeground": "#8C8C8C",
    "focusBorder": "#FFFFFF55",
    "widget.shadow": "#00000080",
    "selection.background": "#FFFFFF33",

    "sideBar.background": "#111111",
    "sideBar.foreground": "#B0B0B0",
    "sideBar.border": "#1C1C1C",
    "sideBarTitle.foreground": "#E6E6E6",
    "sideBarSectionHeader.background": "#111111",
    "sideBarSectionHeader.foreground": "#B0B0B0",

    "activityBar.background": "#111111",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#5C5C5C",
    "activityBar.border": "#1C1C1C",
    "activityBarBadge.background": "#FFFFFF",
    "activityBarBadge.foreground": "#000000",

    "titleBar.activeBackground": "#111111",
    "titleBar.activeForeground": "#B0B0B0",
    "titleBar.inactiveBackground": "#111111",
    "titleBar.inactiveForeground": "#5C5C5C",
    "titleBar.border": "#1C1C1C",

    "statusBar.background": "#111111",
    "statusBar.foreground": "#8C8C8C",
    "statusBar.border": "#1C1C1C",
    "statusBar.noFolderBackground": "#111111",
    "statusBar.debuggingBackground": "#FFFFFF",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.remoteBackground": "#FFFFFF",
    "statusBarItem.remoteForeground": "#000000",
    "statusBarItem.hoverBackground": "#FFFFFF14",

    "tab.activeBackground": "#0A0A0A",
    "tab.activeForeground": "#FFFFFF",
    "tab.activeBorderTop": "#FFFFFF",
    "tab.inactiveBackground": "#111111",
    "tab.inactiveForeground": "#6E6E6E",
    "tab.border": "#1C1C1C",
    "tab.hoverBackground": "#181818",
    "editorGroupHeader.tabsBackground": "#111111",
    "editorGroupHeader.tabsBorder": "#1C1C1C",
    "editorGroup.border": "#1C1C1C",

    "panel.background": "#0A0A0A",
    "panel.border": "#1C1C1C",
    "panelTitle.activeForeground": "#FFFFFF",
    "panelTitle.activeBorder": "#FFFFFF",
    "panelTitle.inactiveForeground": "#6E6E6E",

    "terminal.background": "#0A0A0A",
    "terminal.foreground": "#D9D9D9",
    "terminalCursor.foreground": "#FFFFFF",
    "terminal.ansiBlack": "#0A0A0A",
    "terminal.ansiRed": "#CC5747",
    "terminal.ansiGreen": "#A8C280",
    "terminal.ansiYellow": "#CFA35C",
    "terminal.ansiBlue": "#8AA9C4",
    "terminal.ansiMagenta": "#B48EAD",
    "terminal.ansiCyan": "#82B5A2",
    "terminal.ansiWhite": "#E6E6E6",
    "terminal.ansiBrightBlack": "#5C5C5C",
    "terminal.ansiBrightRed": "#E0705F",
    "terminal.ansiBrightGreen": "#B9D68C",
    "terminal.ansiBrightYellow": "#E6B968",
    "terminal.ansiBrightBlue": "#9CBCD6",
    "terminal.ansiBrightMagenta": "#C7A2C0",
    "terminal.ansiBrightCyan": "#90CBB4",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "input.background": "#181818",
    "input.foreground": "#E6E6E6",
    "input.border": "#262626",
    "input.placeholderForeground": "#5C5C5C",
    "inputOption.activeBackground": "#FFFFFF26",
    "inputOption.activeBorder": "#FFFFFF66",
    "dropdown.background": "#181818",
    "dropdown.foreground": "#E6E6E6",
    "dropdown.border": "#262626",

    "button.background": "#FFFFFF",
    "button.foreground": "#000000",
    "button.hoverBackground": "#D9D9D9",
    "button.secondaryBackground": "#262626",
    "button.secondaryForeground": "#E6E6E6",
    "button.secondaryHoverBackground": "#333333",
    "checkbox.background": "#181818",
    "checkbox.border": "#262626",

    "badge.background": "#FFFFFF",
    "badge.foreground": "#000000",

    "list.activeSelectionBackground": "#FFFFFF1F",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#FFFFFF10",
    "list.hoverBackground": "#FFFFFF0A",
    "list.focusBackground": "#FFFFFF1F",
    "list.highlightForeground": "#FFFFFF",
    "list.errorForeground": "#CC5747",
    "list.warningForeground": "#CFA35C",
    "tree.indentGuidesStroke": "#2A2A2A",

    "scrollbarSlider.background": "#FFFFFF14",
    "scrollbarSlider.hoverBackground": "#FFFFFF26",
    "scrollbarSlider.activeBackground": "#FFFFFF40",
    "scrollbar.shadow": "#00000000",

    "pickerGroup.foreground": "#FFFFFF",
    "pickerGroup.border": "#262626",
    "quickInput.background": "#181818",
    "quickInputList.focusBackground": "#FFFFFF1F",

    "menu.background": "#181818",
    "menu.foreground": "#C2C2C2",
    "menu.selectionBackground": "#FFFFFF1F",
    "menu.selectionForeground": "#FFFFFF",
    "menu.separatorBackground": "#262626",

    "notificationCenter.border": "#262626",
    "notifications.background": "#181818",
    "notifications.foreground": "#E6E6E6",
    "notifications.border": "#262626",

    "breadcrumb.foreground": "#6E6E6E",
    "breadcrumb.focusForeground": "#E6E6E6",
    "breadcrumb.activeSelectionForeground": "#FFFFFF",

    "peekView.border": "#FFFFFF66",
    "peekViewEditor.background": "#181818",
    "peekViewResult.background": "#0A0A0A",
    "peekViewTitle.background": "#181818",
    "peekViewResult.selectionBackground": "#FFFFFF1F",
    "peekViewEditor.matchHighlightBackground": "#FFFFFF26",
    "peekViewResult.matchHighlightBackground": "#FFFFFF26",

    "gitDecoration.modifiedResourceForeground": "#CFA35C",
    "gitDecoration.addedResourceForeground": "#A8C280",
    "gitDecoration.untrackedResourceForeground": "#A8C280",
    "gitDecoration.deletedResourceForeground": "#CC5747",
    "gitDecoration.ignoredResourceForeground": "#454545",
    "gitDecoration.conflictingResourceForeground": "#DE9077",

    "diffEditor.insertedTextBackground": "#A8C28026",
    "diffEditor.removedTextBackground": "#CC574726",
    "diffEditor.insertedLineBackground": "#A8C28014",
    "diffEditor.removedLineBackground": "#CC574714",

    "minimap.background": "#0A0A0A",
    "minimap.selectionHighlight": "#FFFFFF33",
    "minimapSlider.background": "#FFFFFF0A",
    "minimapSlider.hoverBackground": "#FFFFFF14",
    "minimapSlider.activeBackground": "#FFFFFF1F"
  },
  "semanticTokenColors": {
    "keyword": "#CC5747",
    "function": "#8AA9C4",
    "method": "#8AA9C4",
    "variable": "#D6D6D6",
    "variable.readonly": "#E6E6E6",
    "parameter": "#B3B3B3",
    "property": "#CCCCCC",
    "type": "#CFA35C",
    "interface": "#CFA35C",
    "typeParameter": "#CFA35C",
    "class": "#CFA35C",
    "enum": "#CFA35C",
    "enumMember": "#CFCFCF",
    "namespace": "#B3B3B3",
    "string": "#A8C280",
    "number": "#82B5A2",
    "comment": "#525252",
    "decorator": "#B3B3B3"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#525252", "fontStyle": "" }
    },
    {
      "name": "Keywords, storage, control flow",
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": { "foreground": "#CC5747", "fontStyle": "" }
    },
    {
      "name": "Brick red keywords (let/const/var, function, export, default)",
      "scope": [
        "storage.type.ts",
        "storage.type.tsx",
        "storage.type.js",
        "storage.type.jsx",
        "storage.type.function.ts",
        "storage.type.function.tsx",
        "storage.type.function.js",
        "storage.type.function.jsx",
        "keyword.control.export",
        "keyword.control.default",
        "storage.type.type.ts",
        "storage.type.type.tsx",
        "storage.type.interface.ts",
        "storage.type.interface.tsx",
        "storage.type.class.ts",
        "storage.type.class.tsx",
        "storage.type.class.js",
        "storage.type.class.jsx"
      ],
      "settings": { "foreground": "#CC5747", "fontStyle": "" }
    },
    {
      "name": "Import / from",
      "scope": ["keyword.control.import", "keyword.control.from"],
      "settings": { "foreground": "#CC5747", "fontStyle": "" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#A6A6A6", "fontStyle": "" }
    },
    {
      "name": "Functions and methods (camelCase)",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": { "foreground": "#8AA9C4", "fontStyle": "" }
    },
    {
      "name": "PascalCase functions (components) — match JSX tag gold",
      "scope": ["entity.name.function.pascalcase.monobw"],
      "settings": { "foreground": "#CFA35C", "fontStyle": "" }
    },
    {
      "name": "Classes, types, interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.type.interface",
        "entity.name.type.alias"
      ],
      "settings": { "foreground": "#CFA35C", "fontStyle": "" }
    },
    {
      "name": "Type primitives (string, number, boolean...)",
      "scope": ["support.type.primitive", "support.type.builtin"],
      "settings": { "foreground": "#CFA35C", "fontStyle": "" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "meta.definition.variable variable"],
      "settings": { "foreground": "#D6D6D6" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#B3B3B3", "fontStyle": "" }
    },
    {
      "name": "Object properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#CCCCCC", "fontStyle": "" }
    },
    {
      "name": "Constants and language constants",
      "scope": [
        "constant",
        "constant.language",
        "constant.numeric",
        "support.constant"
      ],
      "settings": { "foreground": "#82B5A2" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#A8C280", "fontStyle": "" }
    },
    {
      "name": "Template literal interpolation ${}",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": { "foreground": "#E6E6E6", "fontStyle": "" }
    },
    {
      "name": "Template literal expression content",
      "scope": ["meta.template.expression"],
      "settings": { "foreground": "#D6D6D6" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#B3B3B3" }
    },
    {
      "name": "Punctuation, brackets, delimiters",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor"
      ],
      "settings": { "foreground": "#6E6E6E", "fontStyle": "" }
    },
    {
      "name": "Decorators",
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#B3B3B3", "fontStyle": "" }
    },
    {
      "name": "JSX/HTML tags — intrinsics and components, same gold",
      "scope": [
        "entity.name.tag",
        "support.class.component",
        "entity.name.tag support.class.component"
      ],
      "settings": { "foreground": "#CFA35C", "fontStyle": "" }
    },
    {
      "name": "JSX/HTML attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#9C9C9C", "fontStyle": "" }
    },
    {
      "name": "JSX tag punctuation < / >",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": { "foreground": "#5C5C5C" }
    },
    {
      "name": "JSON property keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#C6A97B", "fontStyle": "" }
    },
    {
      "name": "JSON string values",
      "scope": ["source.json string.quoted.double.json"],
      "settings": { "foreground": "#A8C280" }
    },
    {
      "name": "JSON keys stay consistent even when nested",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": { "foreground": "#C6A97B" }
    },
    {
      "name": ".env keys",
      "scope": [
        "variable.key.dotenv",
        "variable.other.env",
        "source.env variable",
        "keyword.other.definition.ini",
        "support.constant.dotenv"
      ],
      "settings": { "foreground": "#C6A97B", "fontStyle": "" }
    },
    {
      "name": ".env values",
      "scope": [
        "source.dotenv",
        "source.dotenv string",
        "source.dotenv constant",
        "string.value.dotenv",
        "source.env string",
        "string.quoted.single.env",
        "string.quoted.double.env",
        "source.env constant"
      ],
      "settings": { "foreground": "#FFFFFF" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FFFFFF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#D6D6D6", "fontStyle": "italic" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#B3B3B3" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#8C8C8C" }
    },
    {
      "name": "Invalid / deprecated",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": { "foreground": "#CC5747", "fontStyle": "underline" }
    }
  ]
}
