{
  "name": "builtt-dark-theme",
  "displayName": "Builtt Dark Theme",
  "description": "Earthy dark theme on stable charcoal: lavender, gold, sage, teal and blue. Tuned for TS/JS/JSX/TSX, JSON, .env and Markdown",
  "publisher": "wayz9",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayz9/vscode-dark-theme"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Themes"],
  "contributes": {
    "themes": [
      {
        "label": "Builtt Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/mono-bw-color-theme.json"
      }
    ],
    "grammars": [
      {
        "scopeName": "mono-bw.case-injection",
        "path": "./syntaxes/case-injection.json",
        "injectTo": ["source.ts", "source.tsx", "source.js", "source.jsx"]
      }
    ]
  }
}
